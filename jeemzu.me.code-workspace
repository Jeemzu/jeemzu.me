{
  "folders": [
    {
      "path": ".",
    },
    {
      "path": "../jeemzu.api",
    },
  ],
  "settings": {
    "js/ts.tsdk.path": "node_modules/typescript/lib",
    "task.allowAutomaticTasks": "on",
    "powershell.cwd": "jeemzu.me",
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Dev: All",
        "dependsOn": [
          "API: Dev Server",
          "Frontend: Dev Server",
        ],
        "dependsOrder": "parallel",
        "runOptions": {
          "runOn": "folderOpen",
        },
        "problemMatcher": [],
      },
      {
        "label": "Frontend: Dev Server",
        "type": "shell",
        "command": "npm",
        "args": ["run", "dev", "--", "--port", "5174", "--strictPort"],
        "options": {
          "cwd": "${workspaceFolder:jeemzu.me}",
        },
        "isBackground": true,
        "problemMatcher": [],
        "presentation": {
          "panel": "new",
          "reveal": "always",
        },
      },
      {
        "label": "API: Dev Server",
        "type": "shell",
        "command": "dotnet",
        "args": ["run", "--launch-profile", "Development"],
        "dependsOn": "Docker: Dev Services",
        "options": {
          "cwd": "${workspaceFolder:jeemzu.api}\\src\\JeemzuApi",
          "env": {
            "Frontend__BaseUrl": "http://localhost:5174",
          },
        },
        "isBackground": true,
        "problemMatcher": [],
        "presentation": {
          "panel": "new",
          "reveal": "always",
        },
      },
      {
        "label": "Docker: Dev Services",
        "type": "shell",
        "command": "docker",
        "args": [
          "compose",
          "--project-name", "jeemzuapi",
          "--file", "docker-compose.yml",
          "up", "--detach", "--wait", "--wait-timeout", "60", "postgres",
        ],
        "options": {
          "cwd": "${workspaceFolder:jeemzu.api}",
        },
        "problemMatcher": [],
        "presentation": {
          "panel": "new",
          "reveal": "always",
        },
      },
    ],
  },
}
